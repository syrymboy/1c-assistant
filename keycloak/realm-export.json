{
  "realm": "assistant",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "roles": {
    "realm": [
      {
        "name": "admin"
      },
      {
        "name": "analyst"
      },
      {
        "name": "manager"
      }
    ]
  },
  "users": [
    {
      "username": "admin1",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Админ",
      "lastName": "Админов",
      "email": "admin1@example.com",
      "credentials": [
        {
          "type": "password",
          "value": "admin1",
          "temporary": false
        }
      ],
      "realmRoles": [
        "admin"
      ]
    },
    {
      "username": "analyst1",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Анна",
      "lastName": "Аналитикова",
      "email": "analyst1@example.com",
      "credentials": [
        {
          "type": "password",
          "value": "analyst1",
          "temporary": false
        }
      ],
      "realmRoles": [
        "analyst"
      ]
    },
    {
      "username": "manager1",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Михаил",
      "lastName": "Менеджеров",
      "email": "manager1@example.com",
      "credentials": [
        {
          "type": "password",
          "value": "manager1",
          "temporary": false
        }
      ],
      "realmRoles": [
        "manager"
      ]
    }
  ],
  "clients": [
    {
      "clientId": "assistant-web",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "http://localhost:3000/*"
      ],
      "webOrigins": [
        "http://localhost:3000"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:3000/*"
      },
      "protocolMappers": [
        {
          "name": "realm roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "claim.name": "realm_access.roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ]
}