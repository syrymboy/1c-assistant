# Копия в .env; значения ниже — только для локальной разработки.
KEYCLOAK_DB_PASSWORD=keycloak
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
APP_DB_PASSWORD=app
# Адрес Keycloak глазами браузера (он же issuer в токенах)
KEYCLOAK_PUBLIC_URL=http://localhost:8080
# Порт backend на хосте (если 8000 занят)
BACKEND_PORT=8000
