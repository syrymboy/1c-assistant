# Копия в .env; значения ниже — только для локальной разработки.
KEYCLOAK_DB_PASSWORD=keycloak
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
APP_DB_PASSWORD=app
# Внешний адрес приложения (для доступа снаружи, например ngrok-домен). Keycloak и API идут через него же: /auth и /api
PUBLIC_URL=http://localhost:3000
# Порт backend на хосте (если 8000 занят)
BACKEND_PORT=8000
