# Копия в .env; значения ниже — только для локальной разработки.
KEYCLOAK_DB_PASSWORD=keycloak
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
APP_DB_PASSWORD=app
# Внешний адрес приложения (для доступа снаружи, например ngrok-домен). Keycloak и API идут через него же: /auth и /api
PUBLIC_URL=http://localhost:3000
# Порт backend на хосте (если 8000 занят)
BACKEND_PORT=8000
# LLM: mock (заглушка, без ключей), gemini (бесплатный ключ: aistudio.google.com/apikey) или anthropic
LLM_PROVIDER=mock
LLM_MODEL=claude-sonnet-5-5
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# запасные модели через запятую: подключаются, когда основная перегружена (503)
GEMINI_FALLBACKS=gemini-flash-lite-latest,gemini-3.5-flash,gemini-4-hydrogen
# Секрет подписи вебхуков платёжного провайдера (в проде — длинная случайная строка)
PAYMENT_WEBHOOK_SECRET=dev-webhook-secret
# Платежи: simulator (встроенный, без ключей) или stripe (тестовый режим)
PAYMENT_PROVIDER=simulator
# Для stripe: sk_test_... из Dashboard → Developers → API keys (только тестовые ключи!)
STRIPE_SECRET_KEY=
# whsec_... — выдаёт `stripe listen --forward-to localhost:3000/api/webhooks/stripe` или endpoint в Dashboard
STRIPE_WEBHOOK_SECRET=
# 1С по OData. По умолчанию — заглушка onec-mock из docker-compose (тестовые данные).
# Для настоящей базы: ONEC_ODATA_URL=http://<сервер>/<имя_базы>/odata/standard.odata и учётные данные пользователя 1С (только чтение)
ONEC_ODATA_URL=http://onec-mock:8100/odata/standard.odata
ONEC_USER=odata
ONEC_PASSWORD=odata
